APP_ENV=test
PORT=8000
# All three must belong to the SAME owner-confirmed TEST Supabase project.
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
# Pooler URL is reserved for owner-reviewed SQL. Runtime uses Supabase REST/RPC.
SUPABASE_DATABASE_URL=
FRONTEND_URL=http://localhost:5173
AUTH_REDIRECT_URL=http://localhost:5173/set-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
TRUST_PROXY_HOPS=0
PRIMARY_SUPER_ADMIN_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SQS_QUEUE_URL=
# Explicitly matches checked-in stripe-python 15.6.0; verify old deployment before cutover.
STRIPE_API_VERSION=2026-08-26.dahlia
RESEND_FROM_ADDRESS=Living The Charge <news@livingthecharge.org>
ORG_MAILING_ADDRESS=
# Integration harness refuses any other project; never configure live credentials here.
TEST_SUPABASE_PROJECT_REF=vgqvaluplhbgyrvzvgue
# Generated synthetic operator credentials are present only in ignored local .env.
TEST_OPERATOR_EMAIL=
TEST_OPERATOR_PASSWORD=
TEST_OPERATOR_ID=
# Optional read-only GA4 reports. Independent of billing/schema migrations.
GA4_ENABLED=false
# Numeric GA4 property ID (not the public G- measurement ID).
GA4_PROPERTY_ID=0
GA4_CLIENT_EMAIL=
# Backend only: PKCS8 private key with escaped \n, never a VITE_* variable.
GA4_PRIVATE_KEY=
GA4_HOSTNAMES=
